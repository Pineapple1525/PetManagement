<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.DatePicker?>

<BorderPane xmlns:fx="http://javafx.com/fxml" fx:controller="com.petmanagement.controller.EditOrderController">

    <top>
        <Label text="Chỉnh sửa đơn hàng"
               style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-padding: 10;"
               BorderPane.alignment="CENTER" />
    </top>

    <center>
        <GridPane hgap="10" vgap="10" >
            <columnConstraints>
                <ColumnConstraints percentWidth="30"/>
                <ColumnConstraints percentWidth="70"/>
            </columnConstraints>

            <!-- Order Code (read-only) -->
            <Label text="Mã đơn hàng:" GridPane.rowIndex="0" GridPane.columnIndex="0" />
            <Label fx:id="lblOrderId" GridPane.rowIndex="0" GridPane.columnIndex="1" />

            <!-- Customer -->
            <Label text="Khách hàng:" GridPane.rowIndex="1" GridPane.columnIndex="0" />
            <ComboBox fx:id="cbCustomer" prefWidth="250" GridPane.rowIndex="1" GridPane.columnIndex="1" />

            <!-- Employee -->
            <Label text="Nhân viên:" GridPane.rowIndex="2" GridPane.columnIndex="0" />
            <ComboBox fx:id="cbEmployee" prefWidth="250" GridPane.rowIndex="2" GridPane.columnIndex="1" />

            <!-- Order Date -->
            <Label text="Ngày đặt hàng:" GridPane.rowIndex="3" GridPane.columnIndex="0" />
            <DatePicker fx:id="dpOrderDate" GridPane.rowIndex="3" GridPane.columnIndex="1" />

            <!-- Status -->
            <Label text="Trạng thái:" GridPane.rowIndex="4" GridPane.columnIndex="0" />
            <ComboBox fx:id="cbStatus" prefWidth="250" GridPane.rowIndex="4" GridPane.columnIndex="1" />

            <!-- Payment Method -->
            <Label text="Phương thức thanh toán:" GridPane.rowIndex="5" GridPane.columnIndex="0" />
            <ComboBox fx:id="cbPaymentMethod" prefWidth="250" GridPane.rowIndex="5" GridPane.columnIndex="1" />

            <!-- Notes -->
            <Label text="Ghi chú:" GridPane.rowIndex="6" GridPane.columnIndex="0" />
            <TextArea fx:id="txtNote" prefRowCount="3" wrapText="true"
                      GridPane.rowIndex="6" GridPane.columnIndex="1" />
        </GridPane>
    </center>

    <bottom>
        <HBox spacing="10" alignment="CENTER_RIGHT" >
            <Button text="Lưu" onAction="#onSave" />
            <Button text="Hủy" onAction="#onCancel" />
        </HBox>
    </bottom>
</BorderPane>

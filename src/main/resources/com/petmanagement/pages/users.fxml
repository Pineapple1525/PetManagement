<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Pos?>

<AnchorPane xmlns:fx="http://javafx.com/fxml" fx:controller="com.petmanagement.controller.UserController" stylesheets="@../styles/order.css" prefWidth="800" prefHeight="600">

    <VBox spacing="15" AnchorPane.topAnchor="20" AnchorPane.leftAnchor="20" AnchorPane.rightAnchor="20" AnchorPane.bottomAnchor="20">

        <!-- Tiêu đề -->
        <Label text="Quản lý người dùng" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #2d2d2d;" />

        <!-- Phần tìm kiếm -->
        <HBox spacing="10" alignment="CENTER_LEFT">
            <TextField fx:id="searchField" promptText="Tìm kiếm người dùng..." style="-fx-padding: 5px; -fx-font-size: 14px;" />
<!--            <Button text="Tìm kiếm" onAction="#handleSearch" style="-fx-padding: 5px 15px; -fx-font-size: 14px;" />-->
        </HBox>

        <!-- Phần thêm người dùng -->
        <HBox spacing="15" alignment="CENTER_LEFT" style="-fx-padding: 10px 0;">
            <Button text="Thêm Người Dùng" onAction="#handleAddUser" style="-fx-padding: 10px 20px; -fx-font-size: 16px; -fx-background-color: #4CAF50; -fx-text-fill: white;" />
        </HBox>

        <!-- Bảng người dùng -->
        <TableView fx:id="userTable" style="-fx-border-color: #ddd; -fx-border-width: 1px;">
            <columns>
                <TableColumn fx:id="colId" text="ID" prefWidth="50" />
                <TableColumn fx:id="colUsername" text="Username" prefWidth="150" />
                <TableColumn fx:id="colEmail" text="Email" prefWidth="200" />
                <TableColumn fx:id="colRole" text="Role" prefWidth="100" />
                <TableColumn fx:id="colAction" text="Hành Động" prefWidth="100" />
            </columns>
        </TableView>

        <!-- Phần nút thao tác -->
<!--        <HBox spacing="15" alignment="CENTER_RIGHT" style="-fx-padding: 10px 0;">-->
<!--            <Button text="Sửa" onAction="#handleEdit" style="-fx-padding: 8px 16px; -fx-font-size: 14px; -fx-background-color: #FFC107; -fx-text-fill: white;" />-->
<!--            <Button text="Xoá" onAction="#handleDelete" style="-fx-padding: 8px 16px; -fx-font-size: 14px; -fx-background-color: #F44336; -fx-text-fill: white;" />-->
<!--        </HBox>-->

    </VBox>
</AnchorPane>

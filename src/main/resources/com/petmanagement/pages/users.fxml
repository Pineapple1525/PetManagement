<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane xmlns:fx="http://javafx.com/fxml" fx:controller="com.petmanagement.controller.UserController" prefWidth="800" prefHeight="600">
    <VBox spacing="10" AnchorPane.topAnchor="10" AnchorPane.leftAnchor="10" AnchorPane.rightAnchor="10" AnchorPane.bottomAnchor="10">
        <Label text="Quản lý người dùng" style="-fx-font-size: 18px;"/>
        <TableView fx:id="userTable">
            <columns>
                <TableColumn text="ID" fx:id="colId"/>
                <TableColumn text="Username" fx:id="colUsername"/>
                <TableColumn text="Email" fx:id="colEmail"/>
                <TableColumn text="Role" fx:id="colRole"/>
                <TableColumn text="Created At" fx:id="colCreatedAt"/>
            </columns>
        </TableView>
        <HBox spacing="10">
            <Button text="Thêm" onAction="#handleAdd"/>
            <Button text="Sửa" onAction="#handleEdit"/>
            <Button text="Xoá" onAction="#handleDelete"/>
        </HBox>
    </VBox>
</AnchorPane>

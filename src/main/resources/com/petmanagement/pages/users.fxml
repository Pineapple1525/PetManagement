<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Pos?>
<?import javafx.geometry.Insets?>

<AnchorPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.petmanagement.controller.UserController"
            id="orders-root"
            stylesheets="@../styles/order.css">

    <VBox spacing="10">
        <padding>
            <Insets top="15" right="15" bottom="15" left="15"/>
        </padding>

        <Label text="User" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #2d2d2d;" />
        <HBox spacing="10" alignment="CENTER_LEFT">
            <TextField fx:id="searchField" promptText="Search User..." style="-fx-padding: 5px; -fx-font-size: 14px;" prefWidth="300" />
        </HBox>
        <HBox spacing="15" alignment="CENTER_LEFT" style="-fx-padding: 10px 0;">
            <Button text="Add User" onAction="#handleAddUser" styleClass="button" fx:id="btnAdd" />
        </HBox>
        <HBox alignment="CENTER" spacing="10">
            <TableView fx:id="userTable"
                       prefHeight="400"
                       maxWidth="1100"
                       styleClass="table-view">
                <columns>
                    <TableColumn fx:id="colId" text="ID" prefWidth="80"/>
                    <TableColumn fx:id="colUsername" text="User Name" prefWidth="180"/>
                    <TableColumn fx:id="colEmail" text="Email" prefWidth="250"/>
                    <TableColumn fx:id="colRole" text="Role" prefWidth="120"/>
                    <TableColumn fx:id="colAction" text="Action" prefWidth="150"/>
                </columns>
            </TableView>
        </HBox>
    </VBox>
</AnchorPane>

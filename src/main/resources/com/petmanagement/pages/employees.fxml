<?xml version="1.0" encoding="UTF-8"?>
<?import java.lang.String?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.collections.FXCollections?>

<AnchorPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.petmanagement.controller.EmployeeController"
            id="orders-root"
            prefHeight="800" prefWidth="1300"
            stylesheets="@../styles/order.css">

    <children>
        <VBox spacing="10">
            <padding>
                <Insets top="15" right="15" bottom="15" left="15"/>
            </padding>

            <Label text="List Employee"
                   styleClass="header-label"/>
            <HBox spacing="10" alignment="CENTER_LEFT">
                <TextField fx:id="searchField"
                           promptText="Search By Name And ID..."
                           prefWidth="300"
                           id="searchField"/>

<!--                <Button text="🔍" onAction="#handleSearch"-->
<!--                        prefWidth="40" prefHeight="40"-->
<!--                        maxWidth="40" maxHeight="40"-->
<!--                        minWidth="40" minHeight="40"-->
<!--                        style="-fx-font-size: 14px; -fx-background-radius: 20;"/>-->

                <ComboBox fx:id="genderFilter"
                          promptText="Gender"
                          prefWidth="120"
                          styleClass="combo-box">
                    <items>
                        <FXCollections fx:factory="observableArrayList">
                            <String fx:value="Male"/>
                            <String fx:value="Female"/>
                            <String fx:value="Other"/>
                        </FXCollections>
                    </items>
                </ComboBox>

                <ComboBox fx:id="roleFilter"
                          promptText="Role"
                          prefWidth="150"
                          styleClass="combo-box">
                    <items>
                        <FXCollections fx:factory="observableArrayList">
                            <String fx:value="Manager"/>
                            <String fx:value="Employee"/>
                            <String fx:value="Boss"/>
                        </FXCollections>
                    </items>
                </ComboBox>
            </HBox>
            <HBox alignment="CENTER">
                <TableView fx:id="employeeTable"
                           prefHeight="400"
                           maxWidth="1100"
                           styleClass="table-view">
                    <columns>
                        <TableColumn fx:id="colId" text="ID" prefWidth="60"/>
                        <TableColumn fx:id="colCode" text="Employee Code" prefWidth="100"/>
                        <TableColumn fx:id="colName" text="Full Name" prefWidth="150"/>
                        <TableColumn fx:id="colGender" text="Gender" prefWidth="80"/>
                        <TableColumn fx:id="colBirth" text="Date Of Birth" prefWidth="120"/>
                        <TableColumn fx:id="colPhone" text="Phone Number" prefWidth="120"/>
                        <TableColumn fx:id="colEmail" text="Email" prefWidth="180"/>
                        <TableColumn fx:id="colRole" text="Role" prefWidth="100"/>
                        <TableColumn fx:id="colAddress" text="Address" prefWidth="150"/>
                        <TableColumn fx:id="colSalary" text="Salary" prefWidth="100"/>
                        <TableColumn fx:id="colWorkShift" text="Work Shift" prefWidth="100"/>
                        <TableColumn fx:id="colStatus" text="Status" prefWidth="100"/>
                        <TableColumn fx:id="colHiringDate" text="Hiring Date" prefWidth="120"/>
                        <TableColumn fx:id="colActions" text="Actions" prefWidth="150"/>
                    </columns>
                </TableView>
            </HBox>
            <HBox spacing="10" alignment="CENTER">
                <Button fx:id="btnPrev" text="Trước" onAction="#handlePrevPage"/>
                <Label fx:id="lblPageInfo" text="Trang 1"/>
                <Button fx:id="btnNext" text="Sau" onAction="#handleNextPage"/>
            </HBox>

            <HBox spacing="10" alignment="CENTER_RIGHT">
                <Button text="Add"
                        fx:id="btnAdd"
                        onAction="#handleAddEmployee"
                        styleClass="button"/>
            </HBox>
        </VBox>
    </children>
</AnchorPane>

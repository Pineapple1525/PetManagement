<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml" fx:controller="com.petmanagement.controller.OrderDetailController" stylesheets="@../styles/font_input.css">

    <top>
        <VBox spacing="10" >
            <Label text="Chi Tiết Đơn Hàng" style="-fx-font-size: 18px; -fx-font-weight: bold;" />

            <GridPane hgap="10" vgap="10">
                <columnConstraints>
                    <ColumnConstraints percentWidth="25"/>
                    <ColumnConstraints percentWidth="75"/>
                </columnConstraints>

                <Label text="Mã đơn hàng:" GridPane.rowIndex="0" GridPane.columnIndex="0" />
                <Label fx:id="lblOrderCode" GridPane.rowIndex="0" GridPane.columnIndex="1" />

                <Label text="Khách hàng:" GridPane.rowIndex="1" GridPane.columnIndex="0" />
                <Label fx:id="lblCustomer" GridPane.rowIndex="1" GridPane.columnIndex="1" />

                <Label text="Nhân viên:" GridPane.rowIndex="2" GridPane.columnIndex="0" />
                <Label fx:id="lblEmployee" GridPane.rowIndex="2" GridPane.columnIndex="1" />

                <Label text="Ngày đặt hàng:" GridPane.rowIndex="3" GridPane.columnIndex="0" />
                <Label fx:id="lblOrderDate" GridPane.rowIndex="3" GridPane.columnIndex="1" />

                <Label text="Trạng thái đơn hàng:" GridPane.rowIndex="4" GridPane.columnIndex="0" />
                <Label fx:id="lblStatus" GridPane.rowIndex="4" GridPane.columnIndex="1" />

                <Label text="Phương thức thanh toán:" GridPane.rowIndex="5" GridPane.columnIndex="0" />
                <Label fx:id="lblPaymentMethod" GridPane.rowIndex="5" GridPane.columnIndex="1" />

                <Label text="Ghi chú:" GridPane.rowIndex="6" GridPane.columnIndex="0" />
                <TextArea fx:id="txtNote" editable="false" wrapText="true" prefRowCount="2"
                          GridPane.rowIndex="6" GridPane.columnIndex="1" />
            </GridPane>
        </VBox>
    </top>

    <center>
        <VBox spacing="10" >
            <Label text="Danh Sách Sản Phẩm / Thú Cưng" style="-fx-font-weight: bold;" />

            <TableView fx:id="tblOrderDetails">
                <columns>
                    <TableColumn fx:id="colProductType" text="Product Type"/>
                    <TableColumn fx:id="colProductName" text="Product Name"/>
                    <TableColumn fx:id="colSalePrice" text="Sale Price"/>
                    <TableColumn fx:id="colQuantity" text="Quantity"/>
                    <TableColumn fx:id="colWeight" text="Weight"/>
                </columns>
            </TableView>
        </VBox>
    </center>

    <bottom>
        <HBox spacing="10" alignment="CENTER_RIGHT" >
            <Label text="Tổng tiền:" />
            <Label fx:id="lblTotalPrice" style="-fx-font-weight: bold;" />
            <Button text="Đóng" onAction="#onClose" />
        </HBox>
    </bottom>
</BorderPane>

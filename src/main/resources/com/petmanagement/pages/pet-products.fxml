<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.petmanagement.controller.ProductController"
            stylesheets="@../styles/product.css"
            style=" -fx-font-family: 'Patrick Hand'; -fx-background-color:#CBB69D;"
            prefWidth="1300" prefHeight="800">

    <!-- Top: Header -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="10" style="-fx-padding: 10;">
            <Label text="Pet Products" style="-fx-font-size: 24px; -fx-font-weight: bold;" />
            <Region HBox.hgrow="ALWAYS"/>
            <TextField fx:id="searchField" promptText="Search products..." prefWidth="300" prefHeight="45"/>
            <Button text="Search" style="-fx-pref-width: 100px;">

            </Button>

            <Button fx:id="addProductBtn" text="Add Product"
                    style="-fx-background-color: #A67B5B; -fx-text-fill: white; -fx-pref-width: 100px;"
                    onAction="#openAddProductDialog">
                <HBox.margin>
                    <Insets right="250"/>
                </HBox.margin>
            </Button>



        </HBox>
    </top>

    <!-- Center: Product Table -->
    <center>
        <AnchorPane>
            <TableView fx:id="productTable"
                       AnchorPane.topAnchor="30"
                       AnchorPane.bottomAnchor="100"
                       AnchorPane.leftAnchor="50"
                       AnchorPane.rightAnchor="50">
                <columns>
                    <TableColumn fx:id="idColumn" text="ID" prefWidth="50"/>
                    <TableColumn fx:id="codeColumn" text="Mã SP" prefWidth="90"/>
                    <TableColumn fx:id="nameColumn" text="Tên SP" prefWidth="90"/>
                    <TableColumn fx:id="categoryColumn" text="Danh mục" prefWidth="100"/>
                    <TableColumn fx:id="brandColumn" text="Thương hiệu" prefWidth="100"/>
                    <TableColumn fx:id="descriptionColumn" text="Mô tả" prefWidth="150"/>
                    <TableColumn fx:id="priceColumn" text="Giá" prefWidth="100"/>
                    <TableColumn fx:id="stockColumn" text="Kho" prefWidth="60"/>
                    <TableColumn fx:id="imageColumn" text="Ảnh" prefWidth="100"/>
                    <TableColumn fx:id="supplierColumn" text="Nhà cung cấp" prefWidth="100"/>
                    <TableColumn fx:id="importDateColumn" text="Ngày nhập" prefWidth="100"/>
                    <TableColumn fx:id="actionColumn" text="Hành động" prefWidth="150"/>

                </columns>
            </TableView>
        </AnchorPane>
    </center>

</BorderPane>

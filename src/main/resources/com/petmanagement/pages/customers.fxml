<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>

<BorderPane  xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/23.0.1" fx:controller="com.petmanagement.controller.CustomersController"
            id="orders-root"
            stylesheets="@../styles/order.css" prefHeight="800" prefWidth="1300">

    <!-- Table displaying customer list -->
    <top>
        <HBox alignment="CENTER" spacing="10" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="10" left="10" right="10" top="10" />
            </padding>

            <Label text="Search by name:" />
            <TextField fx:id="searchField" promptText="Enter customer name..." />
        </HBox>
    </top>

    <center>
        <TableView fx:id="customerTable"  >
            <columns>
                <TableColumn fx:id="idCol" prefWidth="50" text="ID" />
                <TableColumn fx:id="codeCol" prefWidth="100" text="Code" />
                <TableColumn fx:id="nameCol" prefWidth="150" text="Name" />
                <TableColumn fx:id="phoneCol" prefWidth="120" text="Phone" />
                <TableColumn fx:id="emailCol" prefWidth="148" text="Email" />
                <TableColumn fx:id="genderCol" prefWidth="82.4" text="Gender" />
                <TableColumn fx:id="typeCol" prefWidth="80" text="Type" />
                <TableColumn fx:id="spentCol" prefWidth="100" text="Spent" />
                <TableColumn fx:id="addressCol" prefWidth="200" text="Address" />
            </columns>
        </TableView>
    </center>

    <!-- Action buttons -->
    <bottom>
        <HBox alignment="TOP_LEFT"  spacing="10" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="10" left="10" right="10" top="10" />
            </padding>
            <Button onAction="#handleAdd" text="Add" maxWidth="100"/>
            <Button onAction="#handleUpdate" text="Edit" maxWidth="100"/>
            <Button onAction="#handleDelete" text="Delete" maxWidth="100"/>
            <Button onAction="#handleRefresh" text="Refresh" maxWidth="130"/>
<!--            <Button onAction="#handleViewDetail" text="View Details" maxWidth="150" />-->
        </HBox>
    </bottom>

</BorderPane>

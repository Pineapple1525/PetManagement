<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml" fx:controller="com.petmanagement.controller.CustomersController">

    <!-- Tiêu đề -->
    <top>
        <VBox spacing="10" alignment="CENTER">
            <Label text="Quản lý khách hàng" style="-fx-font-size: 20px; -fx-font-weight: bold;" />
            <TextField fx:id="searchField" promptText="Tìm kiếm theo tên..." onKeyReleased="#handleSearch"/>
        </VBox>
    </top>

    <!-- Bảng hiển thị danh sách khách hàng -->
    <center>
        <TableView fx:id="customerTable" prefHeight="400">
            <columns>
                <TableColumn fx:id="idCol" text="ID"/>
                <TableColumn fx:id="codeCol" text="Mã KH"/>
                <TableColumn fx:id="nameCol" text="Tên"/>
                <TableColumn fx:id="phoneCol" text="SĐT"/>
                <TableColumn fx:id="emailCol" text="Email"/>
                <TableColumn fx:id="genderCol" text="Giới tính"/>
                <TableColumn fx:id="typeCol" text="Loại KH"/>
                <TableColumn fx:id="spentCol" text="Đã chi"/>
            </columns>
        </TableView>
    </center>

    <!-- Nút thao tác -->
    <bottom>
        <HBox spacing="10" alignment="CENTER" BorderPane.alignment="CENTER">
            <Button text="Thêm" onAction="#handleAdd"/>
            <Button text="Sửa" onAction="#handleUpdate"/>
            <Button text="Xóa" onAction="#handleDelete"/>
            <Button text="Làm mới" onAction="#handleRefresh"/>
            <Button text="Xem chi tiết" onAction="#showDetailPopup"/>
        </HBox>
    </bottom>

</BorderPane>

<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>
<?import javafx.collections.FXCollections?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.petmanagement.controller.CustomersController"
            prefWidth="800" prefHeight="600">

    <!-- Tiêu đề -->
    <top>
        <VBox spacing="10">
            <Label text="Quản lý khách hàng" style="-fx-font-size: 20px; -fx-font-weight: bold;" />
            <TextField fx:id="searchField" promptText="Tìm kiếm theo tên..." onKeyReleased="#handleSearch"/>
        </VBox>
    </top>

    <!-- Bảng hiển thị danh sách khách hàng -->
    <center>
        <TableView fx:id="customerTable" prefHeight="400">
            <columns>
                <TableColumn fx:id="idCol" text="ID"/>
                <TableColumn fx:id="codeCol" text="Mã KH"/>
                <TableColumn fx:id="nameCol" text="Tên"/>
                <TableColumn fx:id="phoneCol" text="SĐT"/>
                <TableColumn fx:id="emailCol" text="Email"/>
                <TableColumn fx:id="genderCol" text="Giới tính"/>
                <TableColumn fx:id="typeCol" text="Loại KH"/>
                <TableColumn fx:id="spentCol" text="Đã chi"/>
            </columns>
        </TableView>
    </center>

    <!-- Form thêm/sửa + nút điều khiển -->
    <bottom>
        <VBox spacing="10">
            <GridPane hgap="10" vgap="10">
                <Label text="Mã KH:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                <TextField fx:id="codeField" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                <Label text="Tên:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                <TextField fx:id="nameField" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                <Label text="SĐT:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                <TextField fx:id="phoneField" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

                <Label text="Email:" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                <TextField fx:id="emailField" GridPane.rowIndex="3" GridPane.columnIndex="1"/>

                <Label text="Ngày sinh:" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
                <DatePicker fx:id="birthDatePicker" GridPane.rowIndex="4" GridPane.columnIndex="1"/>

                <Label text="Địa chỉ:" GridPane.rowIndex="5" GridPane.columnIndex="0"/>
                <TextField fx:id="addressField" GridPane.rowIndex="5" GridPane.columnIndex="1"/>

                <Label text="Giới tính:" GridPane.rowIndex="6" GridPane.columnIndex="0"/>
                <ComboBox fx:id="genderBox" GridPane.rowIndex="6" GridPane.columnIndex="1"/>

                <Label text="Loại KH:" GridPane.rowIndex="7" GridPane.columnIndex="0"/>
                <ComboBox fx:id="typeBox" GridPane.rowIndex="7" GridPane.columnIndex="1"/>
            </GridPane>

            <HBox spacing="10" alignment="CENTER">
                <Button text="Thêm" onAction="#handleAdd"/>
                <Button text="Sửa" onAction="#handleUpdate"/>
                <Button text="Xóa" onAction="#handleDelete"/>
                <Button text="Làm mới" onAction="#handleRefresh"/>
                <Button text="Xem chi tiết" onAction="#showDetailPopup"/>
            </HBox>
        </VBox>
    </bottom>
</BorderPane>

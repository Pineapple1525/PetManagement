<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>

<BorderPane prefHeight="600" prefWidth="900" xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/23.0.1" fx:controller="com.petmanagement.controller.CustomersController"
            id="orders-root"
            stylesheets="@../styles/order.css">

    <!-- Bảng hiển thị danh sách khách hàng -->
    <top>
        <HBox alignment="CENTER" spacing="10" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="10" left="10" right="10" top="10" />
            </padding>

            <Label text="Tìm kiếm theo tên:" />
            <TextField fx:id="searchField" promptText="Nhập tên khách hàng..." />
            <Button onAction="#handleSearch" text="Tìm"  maxWidth="100"/>
        </HBox>
    </top>

    <center>
        <TableView fx:id="customerTable" prefHeight="400">
            <columns>
                <TableColumn fx:id="idCol" prefWidth="50" text="ID" />
                <TableColumn fx:id="codeCol" prefWidth="100" text="Mã KH" />
                <TableColumn fx:id="nameCol" prefWidth="150" text="Tên" />
                <TableColumn fx:id="phoneCol" prefWidth="120" text="SĐT" />
                <TableColumn fx:id="emailCol" prefWidth="147.99996948242188" text="Email" />
                <TableColumn fx:id="genderCol" prefWidth="82.4000244140625" text="Giới tính" />
                <TableColumn fx:id="typeCol" prefWidth="80" text="Loại KH" />
                <TableColumn fx:id="spentCol" prefWidth="100" text="Đã chi" />
                <TableColumn fx:id="addressCol" prefWidth="200" text="Địa chỉ" />
            </columns>
        </TableView>
    </center>

    <!-- Nút thao tác -->
    <bottom>
        <HBox alignment="TOP_LEFT" prefHeight="46.0" prefWidth="738.0" spacing="10" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="10" left="10" right="10" top="10" />
            </padding>
            <Button onAction="#handleAdd" text="Thêm" maxWidth="100"/>
            <Button onAction="#handleUpdate" text="Sửa"  maxWidth="100"/>
            <Button onAction="#handleDelete" text="Xóa"  maxWidth="100"/>
            <Button onAction="#handleRefresh" text="Làm mới" maxWidth="130"/>
            <Button onAction="#handleViewDetail" text="Xem chi tiết" maxWidth="150" />
        </HBox>
    </bottom>


</BorderPane>

<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<AnchorPane xmlns:fx="http://javafx.com/fxml" fx:controller="com.petmanagement.controller.AddEmployeeController">
    <children>
        <VBox spacing="10" alignment="TOP_LEFT">
            <padding>
                <Insets top="20" right="20" bottom="20" left="20"/>
            </padding>

            <Label text="Thêm nhân viên mới" style="-fx-font-size: 18px; -fx-font-weight: bold;" />

            <TextField fx:id="txtCode" promptText="Mã nhân viên" />
            <TextField fx:id="txtFullname" promptText="Họ và tên" />
            <ComboBox fx:id="cbGender" promptText="Giới tính" />
            <DatePicker fx:id="dpBirthdate" promptText="Ngày sinh" />
            <TextField fx:id="txtAddress" promptText="Địa chỉ" />
            <TextField fx:id="txtPhone" promptText="Số điện thoại" />
            <TextField fx:id="txtEmail" promptText="Email" />
            <TextField fx:id="txtRole" promptText="Vai trò" />
            <TextField fx:id="txtSalary" promptText="Lương" />
            <TextField fx:id="txtWorkShift" promptText="Ca làm" />
            <TextField fx:id="txtStatus" promptText="Trạng thái" />
            <DatePicker fx:id="dpHiringDate" promptText="Ngày vào làm" />

            <HBox spacing="10" alignment="CENTER_RIGHT">
                <Button text="Lưu" onAction="#handleSave" />
                <Button text="Hủy" onAction="#handleCancel" />
            </HBox>
        </VBox>
    </children>
</AnchorPane>

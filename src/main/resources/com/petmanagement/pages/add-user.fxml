<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.*?>

<?import javafx.collections.FXCollections?>
<?import java.lang.String?>
<AnchorPane xmlns:fx="http://javafx.com/fxml" fx:controller="com.petmanagement.controller.AddUserController"
            prefWidth="400" prefHeight="350" style="-fx-background-color: white; -fx-padding: 20;">

    <VBox spacing="15" alignment="CENTER" AnchorPane.topAnchor="10" AnchorPane.leftAnchor="10" AnchorPane.rightAnchor="10" AnchorPane.bottomAnchor="10">
        <Label text="Add User" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

        <TextField fx:id="usernameField" promptText="User Name"/>
        <TextField fx:id="emailField" promptText="Email"/>
        <PasswordField fx:id="passwordField" promptText="Password"/>

        <ComboBox fx:id="roleComboBox" promptText="Role">
            <items>
                <FXCollections fx:factory="observableArrayList">
                    <String fx:value="Manager"/>
                    <String fx:value="Employee"/>
                    <String fx:value="Boss"/>
                </FXCollections>
            </items>
        </ComboBox>

        <HBox spacing="10" alignment="CENTER">
            <Button text="Save" onAction="#handleSaveUser" style="-fx-background-color: #4CAF50; -fx-text-fill: white;"/>
            <Button text="Cancel" onAction="#handleCancel" style="-fx-background-color: #f44336; -fx-text-fill: white;"/>
        </HBox>
    </VBox>
</AnchorPane>

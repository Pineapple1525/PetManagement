<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<?import javafx.collections.FXCollections?>
<?import java.lang.String?>
<BorderPane xmlns:fx="http://javafx.com/fxml" fx:controller="com.petmanagement.controller.OrderController" id="orders-root" stylesheets="@../styles/order.css">

    <top>
        <HBox spacing="10" >
            <TextField fx:id="searchField" promptText="Search by order code / customer name..." prefWidth="400" prefHeight="40"/>
            <Button text="🔍" onAction="#onSearch"
                    prefWidth="40" prefHeight="40"
                    maxWidth="40" maxHeight="40"
                    minWidth="40" minHeight="40"
                    style="-fx-font-size: 14px; -fx-background-radius: 20;"/>
            <VBox spacing="2">
                <Label text="Order Status" style="-fx-font-weight: bold; -fx-font-size: 13px;"/>
                <ComboBox fx:id="statusFilter" promptText="All" prefWidth="130">
                    <items>
                        <FXCollections fx:factory="observableArrayList">
                            <String fx:value="All"/>
                            <String fx:value="Pending"/>
                            <String fx:value="Completed"/>
                            <String fx:value="Cancelled"/>
                        </FXCollections>
                    </items>
                </ComboBox>
            </VBox>

            <!-- Label + ComboBox: Delivery Status -->
            <VBox spacing="2">
                <Label text="Delivery Status" style="-fx-font-weight: bold; -fx-font-size: 13px;"/>
                <ComboBox fx:id="deliveryFilter" promptText="All" prefWidth="130">
                    <items>
                        <FXCollections fx:factory="observableArrayList">
                            <String fx:value="All"/>
                            <String fx:value="Pending"/>
                            <String fx:value="Shipped"/>
                            <String fx:value="Delivered"/>
                            <String fx:value="Cancelled"/>
                        </FXCollections>
                    </items>
                </ComboBox>
            </VBox>
        </HBox>
    </top>

    <!-- ===== Center: Order List Table ===== -->
    <center>
        <TableView fx:id="orderTable" prefHeight="400">
            <columns>
                <TableColumn fx:id="colID" text="Order ID" prefWidth="100"/>
                <TableColumn fx:id="colCode" text="Order Code" prefWidth="100"/>
                <TableColumn fx:id="colCustomer" text="Customer" prefWidth="150"/>
                <TableColumn fx:id="colDate" text="Order Date" prefWidth="130"/>
                <TableColumn fx:id="colTotal" text="Total Amount" prefWidth="100"/>
                <TableColumn fx:id="colStatus" text="Status" prefWidth="100"/>
                <TableColumn fx:id="colPayment" text="Payment" prefWidth="100"/>
                <TableColumn fx:id="colDelivery" text="Delivery" prefWidth="100"/>
            </columns>
        </TableView>
    </center>

    <!-- ===== Bottom: Action Buttons ===== -->
    <bottom>
        <HBox spacing="10" >
            <Button text="Create Order" onAction="#onCreateOrder"/>
            <Button text="View Details" onAction="#onViewDetail"/>
            <Button text="Update Status" onAction="#onUpdateStatus"/>
            <Button text="Delete Order" onAction="#onDeleteOrder"/>
        </HBox>
    </bottom>

</BorderPane>

<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.*?>

<StackPane xmlns="http://javafx.com/javafx"
           xmlns:fx="http://javafx.com/fxml"
           fx:controller="com.petmanagement.controller.LoginController"
           style="-fx-background-color: #ffffff;"
           prefWidth="500" prefHeight="400">

    <VBox alignment="CENTER" spacing="20">
        <!-- Tiêu đề -->
        <Label text="Amateur lotus" style="-fx-font-size: 24px; -fx-font-weight: bold;" />

        <!-- Ô nhập và biểu tượng -->
        <VBox spacing="10" alignment="CENTER">
            <TextField fx:id="usernameField" promptText="Enter your email"
                       style="-fx-background-radius: 8px; -fx-border-radius: 8px; -fx-padding: 10; -fx-background-color: #f2f2f2;"
                       prefWidth="260" maxWidth="260"/>

                <StackPane  prefWidth="260" maxWidth="260">
                <PasswordField fx:id="passwordField" promptText="Password"
                               style="-fx-background-radius: 8px; -fx-border-radius: 8px; -fx-padding: 10; -fx-background-color: #f2f2f2;"
                               prefWidth="260" maxWidth="260" />
                <TextField fx:id="visiblePasswordField" promptText="Password"
                           style="-fx-background-radius: 8px; -fx-border-radius: 8px; -fx-padding: 10; -fx-background-color: #f2f2f2;"
                           />
                </StackPane>
                <!-- Biểu tượng hiện/ẩn -->
                <Label fx:id="togglePasswordIcon"
                       text="👁"
                       style="-fx-cursor: hand; -fx-translate-x: 120;" />


            <Hyperlink fx:id="forgotPasswordLink"
                       text="Forgot password"
                       onAction="#handleForgotPassword"
                       style="-fx-font-size: 12px;" />
        </VBox>

        <!-- Nút đăng nhập -->
        <Button fx:id="loginButton" text="login" onAction="#handleLogin" style="-fx-background-color: #ff884d; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 10px; -fx-padding: 10px 40px;" />



        <!-- Thông báo lỗi -->
        <Label fx:id="errorLabel" textFill="red" style="-fx-font-style: italic;" />
    </VBox>
</StackPane>

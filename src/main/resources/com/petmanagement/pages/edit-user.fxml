<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.petmanagement.controller.EditUserController"
            prefHeight="450.0" prefWidth="600.0">

    <children>
        <VBox alignment="CENTER" spacing="15.0" AnchorPane.topAnchor="30.0" AnchorPane.leftAnchor="50.0" AnchorPane.rightAnchor="50.0">
            <children>

                <Label text="Chỉnh sửa thông tin người dùng">
                    <font>
                        <Font size="20.0"/>
                    </font>
                </Label>

                <GridPane hgap="10" vgap="15">
                    <columnConstraints>
                        <ColumnConstraints halignment="RIGHT" minWidth="100"/>
                        <ColumnConstraints halignment="LEFT" minWidth="300"/>
                    </columnConstraints>

                    <padding>
                        <Insets top="20" left="20" right="20" bottom="10"/>
                    </padding>

                    <children>
                        <Label text="Tên người dùng:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                        <TextField fx:id="usernameField" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                        <Label text="Email:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                        <TextField fx:id="emailField" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                        <Label text="Mật khẩu:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                        <TextField fx:id="passwordField" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

                        <Label text="Vai trò:" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                        <TextField fx:id="roleField" GridPane.rowIndex="3" GridPane.columnIndex="1"/>
                    </children>
                </GridPane>

                <Button text="Lưu thay đổi" fx:id="saveButton" onAction="#handleUpdateUser" maxWidth="150"/>
            </children>
        </VBox>
    </children>
</AnchorPane>

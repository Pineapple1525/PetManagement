<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.*?>

<StackPane xmlns="http://javafx.com/javafx"
           xmlns:fx="http://javafx.com/fxml"
           fx:controller="com.petmanagement.controller.ForgotPasswordController"
           style="-fx-background-color: #ffffff;"
           prefWidth="500" prefHeight="400">

    <VBox alignment="CENTER" spacing="20">
        <!-- Tiêu đề -->
        <Label text="Reset Password" style="-fx-font-size: 24px; -fx-font-weight: bold;" />

        <VBox spacing="10" alignment="CENTER">
            <!-- Email -->
            <TextField fx:id="emailField" promptText="Enter your email"
                       style="-fx-background-radius: 8px; -fx-border-radius: 8px; -fx-padding: 10; -fx-background-color: #f2f2f2;"
                       prefWidth="260" maxWidth="260"/>

            <!-- Mật khẩu mới -->
            <PasswordField fx:id="newPasswordField" promptText="New password"
                           style="-fx-background-radius: 8px; -fx-border-radius: 8px; -fx-padding: 10; -fx-background-color: #f2f2f2;"
                           prefWidth="260" maxWidth="260"/>

            <!-- Nút Reset -->
            <Button text="Reset Password"
                    onAction="#handleResetPassword"
                    style="-fx-background-color: #ff884d; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 10px; -fx-padding: 10px 40px;" />
        </VBox>

        <!-- Thông báo trạng thái -->
        <Label fx:id="statusLabel" textFill="green" style="-fx-font-style: italic;" />
    </VBox>
</StackPane>

<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<AnchorPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.petmanagement.controller.ForgotPasswordController"
            stylesheets="@../styles/order.css">
    <children>
        <Label layoutX="30" layoutY="20" text="Enter your email" />
        <TextField fx:id="emailField" layoutX="30" layoutY="45" />

        <Label layoutX="30" layoutY="85" text="New password" />
        <PasswordField fx:id="newPasswordField" layoutX="30" layoutY="110" />

        <Button text="Reset Password" layoutX="30" layoutY="160" onAction="#handleResetPassword" />

        <Label fx:id="statusLabel" layoutX="30" layoutY="210" textFill="green" />
    </children>
</AnchorPane>

